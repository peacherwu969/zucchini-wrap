zucchini/zucchini_gen.cc.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/zucchini_objects.dir/build.make CMakeFiles/zucchini_objects.dir/zucchini/zucchini_gen.cc.i
.PHONY : zucchini/zucchini_gen.cc.i

zucchini/zucchini_gen.s: zucchini/zucchini_gen.cc.s
.PHONY : zucchini/zucchini_gen.s

# target to generate assembly for a file
zucchini/zucchini_gen.cc.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/zucchini_objects.dir/build.make CMakeFiles/zucchini_objects.dir/zucchini/zucchini_gen.cc.s
.PHONY : zucchini/zucchini_gen.cc.s

